#!/usr/bin/env bash

set -euo pipefail

failed=0
while IFS= read -r project; do
    [[ -n "$project" ]] || continue
    if git show ":$project" | grep -Eq '(DEVELOPMENT_TEAM|DevelopmentTeam)[[:space:]]*=[[:space:]]*"?[A-Z0-9]{10}"?;'; then
        echo "Commit blocked: Apple Development Team ID found in $project" >&2
        failed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.pbxproj')

if (( failed )); then
    echo 'Set the Xcode signing team to None before committing.' >&2
    exit 1
fi
