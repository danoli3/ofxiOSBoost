Pod::Spec.new do |s|
  s.name                  = "ofxiOSBoost"
  s.version               = "@BOOST_VERSION@"
  s.summary               = "Boost C++ libraries precompiled for iOS"
  s.description           = <<-DESC
Boost @BOOST_VERSION@ packaged as a static XCFramework for arm64 iOS devices
and arm64/x86_64 iOS Simulators. The package contains the complete Boost header
tree and a documented selection of compiled Boost libraries.
                            DESC
  s.homepage              = "https://github.com/danoli3/ofxiOSBoost"
  s.documentation_url     = "https://github.com/danoli3/ofxiOSBoost/releases/tag/@BOOST_VERSION@"
  s.license               = { :type => "BSL-1.0", :file => "LICENSE_1_0.txt" }
  s.author                = { "Danoli3" => "danoli3@gmail.com" }

  s.platform              = :ios, "@IOS_MIN_VERSION@"
  s.cocoapods_version     = ">= 1.9"
  s.requires_arc          = false
  s.source                = {
    :http => "https://github.com/danoli3/ofxiOSBoost/releases/download/@BOOST_VERSION@/ofxiOSBoost-@BOOST_VERSION@.tar.gz",
    :sha256 => "@ARCHIVE_SHA@"
  }

  s.vendored_frameworks   = "libs/boost/ios/boost.xcframework"
  s.libraries             = "c++"
  s.module_map            = false
  s.preserve_paths        = "BUILD-INFO.txt", "COMPONENTS.md", "RELEASE-NOTES.md", "VALIDATION.md", "libs/boost/cmake/**/*", "libs/boost/pkgconfig/**/*"
end
