     {
-        flags darwin.compile.c++ OPTIONS $(condition) : -fcoalesce-templates ;
+        # Disabled for modern Apple Clang, whose compatibility version is 4.2.1.
     }
@@ -500,7 +500,9 @@ rule setup-address-model ( targets * : sources * : properties * )
         
         case arm :
         {
