diff --git a/libs/locale/build/Jamfile.v2 b/libs/locale/build/Jamfile.v2
--- a/libs/locale/build/Jamfile.v2
+++ b/libs/locale/build/Jamfile.v2
@@ -213,8 +213,14 @@ rule configure-full ( properties * : flags-only )
       || ! <boost.locale.iconv> in $(properties:G) 
         && ! <target-os>solaris in $(properties)
     {
-        # See if iconv is bundled with standard library.
-        if [ configure.builds has_iconv : $(properties) : "iconv (libc)" ]
+        # iconv is provided by libSystem on iOS. Its configure executable
+        # cannot be linked or run as a host program while cross-compiling.
+        if <target-os>iphone in $(properties)
+        {
+            found-iconv = true ;
+        }
+        # See if iconv is bundled with standard library.
+        else if [ configure.builds has_iconv : $(properties) : "iconv (libc)" ]
         {
             found-iconv = true ;
         }
